# Copie para .env e preencha
# Client ID do Google (o MESMO configurado no backend em GOOGLE_CLIENT_ID). Vazio = botão do Google some.
VITE_GOOGLE_CLIENT_ID=
# URL do backend em produção. Vazio = usa o proxy do Vite (dev)
VITE_API_URL=
# Push no celular (Firebase Cloud Messaging). Firebase Console > Configurações do projeto > Geral > "Seus apps" (app da Web)
# e, para a chave VAPID, Cloud Messaging > Certificados push da Web. Vazio = push aparece como "não configurado".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
