# Copie para .env e preencha
# Client ID do Google (o MESMO configurado no backend em GOOGLE_CLIENT_ID). Vazio = botão do Google some.
VITE_GOOGLE_CLIENT_ID=
# Opcional: cliente OAuth só para o "Criar sala" do Meet (projeto com a Google Meet REST API ligada). Vazio = usa o do login.
VITE_GOOGLE_MEET_CLIENT_ID=
# URL da Edge Function Hono no Supabase (ex.: https://<ref>.supabase.co/functions/v1)
VITE_API_URL=
# Supabase Realtime (chave publishable pública — NUNCA coloque service_role/secret no front!)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Push no celular (Firebase Cloud Messaging). Firebase Console > Configurações do projeto > Geral > "Seus apps" (app da Web)
# e, para a chave VAPID, Cloud Messaging > Certificados push da Web. Vazio = push aparece como "não configurado".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
